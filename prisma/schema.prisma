generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model Team {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  createdById Int
  labels      Label[]
  projects    Project[]
  createdBy   table_users  @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members     TeamMember[]
}

model TeamMember {
  id       Int         @id @default(autoincrement())
  role     TeamRole    @default(member)
  joinedAt DateTime    @default(now())
  userId   Int
  teamId   Int
  team     Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user     table_users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus @default(active)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  teamId      Int
  createdById Int
  createdBy   table_users   @relation("ProjectCreator", fields: [createdById], references: [id])
  team        Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks       Task[]
}

model Task {
  id           Int          @id @default(autoincrement())
  title        String
  description  String?
  status       TaskStatus   @default(todo)
  priority     TaskPriority @default(medium)
  dueDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  projectId    Int
  assignedToId Int?
  createdById  Int
  parentTaskId Int?
  comments     Comment[]
  assignedTo   table_users? @relation("AssignedTasks", fields: [assignedToId], references: [id])
  createdBy    table_users  @relation("CreatedTasks", fields: [createdById], references: [id])
  parentTask   Task?        @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks     Task[]       @relation("SubTasks")
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  labels       TaskLabel[]
}

model Comment {
  id        Int         @id @default(autoincrement())
  body      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  taskId    Int
  userId    Int
  task      Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      table_users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Label {
  id     Int         @id @default(autoincrement())
  name   String
  color  String      @default("#6366f1")
  teamId Int
  team   Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks  TaskLabel[]
}

model TaskLabel {
  taskId  Int
  labelId Int
  label   Label @relation(fields: [labelId], references: [id], onDelete: Cascade)
  task    Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model table_users {
  id            Int          @id(map: "User_pkey") @default(autoincrement())
  name          String
  email         String       @unique(map: "User_email_key")
  password      String
  avatarUrl     String?
  role          UserRole
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  comments      Comment[]
  projects      Project[]    @relation("ProjectCreator")
  assignedTasks Task[]       @relation("AssignedTasks")
  createdTasks  Task[]       @relation("CreatedTasks")
  teamsCreated  Team[]
  memberships   TeamMember[]
}

enum UserRole {
  admin
  member
}
enum TeamRole {
  owner
  admin
  member
}

enum ProjectStatus {
  active
  on_hold
  completed
  archived
}

enum TaskStatus {
  todo
  in_progress
  in_review
  done
}

enum TaskPriority {
  low
  medium
  high
  urgent
}
